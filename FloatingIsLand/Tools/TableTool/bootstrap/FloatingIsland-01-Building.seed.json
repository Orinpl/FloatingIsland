{
  "workbook": "FloatingIsland",
  "sheetOrder": 1,
  "table": "Building",
  "kind": "rows",
  "fields": [
    { "name": "buildingId", "type": "string", "desc": "建筑 Id（主键，camelCase，被关系表引用，一字不差）" },
    { "name": "nameCn", "type": "string", "desc": "显示名" },
    { "name": "category", "type": "string", "desc": "分类：windEnergy 风能 / agriculture 农业 / industry 工业 / storage 仓储 / commerce 商业 / residential 居民 / logistics 物流（UI 分组用）" },
    { "name": "placement", "type": "string", "desc": "建造限制：any 普通合法地块 / greenField 必须绿地 / windPath 必须风带 / floatingZone 只能浮空区域 / oreRange 必须矿藏有效范围内（§11）" },
    { "name": "radius", "type": "int", "desc": "作用半径（格，球形欧氏距离，自占地边缘起算；邻接计分默认用本建筑半径）。§11 建议范围档位换算：小=3 / 中=5 / 大=7 / 极大=10" },
    { "name": "baseScore", "type": "int", "desc": "基础分（落地即得）" },
    { "name": "elementBonus", "type": "string[]", "desc": "地图元素加分：元素Id:分值[:上限]，多个用|分隔（元素Id → MapElement 表；判定范围用元素自身的 radius 有效范围）。巨型风车条目=专属加分，替代 GameConfig.giantWindmillGenericScore 的通用加分不叠加（§6.3），没写巨型风车条目的建筑吃通用加分。例 anchor:20:1。空=无元素加分" },
    { "name": "canLogisticsCover", "type": "bool", "desc": "是否可获得基础物流覆盖分（设计：风帆/物流点/物流中心 FALSE，其余 TRUE，§10.3+真值表B）" },
    { "name": "windScoreByLevel", "type": "int[]", "desc": "风力直接得分曲线，索引=风力 0~5 级，|分隔（船坞=终局风能奖励 §12.8；风帆=建造即时分 §9.1；空=不吃风力分）" },
    { "name": "windPassPenaltyByLevel", "type": "int[]", "desc": "被风直接穿过时的惩罚，索引=风力 0~5 级（居民区 4/5 级填负值 §12.13；空=无惩罚）" },
    { "name": "residentWindMultByLevel", "type": "float[]", "desc": "居民区相关邻接分的风力倍率，索引=风力 0~5 级（风向标专用 §12.1；空=不乘）" },
    { "name": "isolationPenaltyScore", "type": "int", "desc": "孤立惩罚：范围内无任何加分来源时的扣分（负值；船坞用 §12.8；0=无）" },
    { "name": "mvpBatch", "type": "int", "desc": "开发批次：1=MVP 首批，2=第二批（§19）" }
  ],
